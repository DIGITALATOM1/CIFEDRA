{
  "name": "cifedra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm -w @cifedra/core run build && npm -w @cifedra/api run build",
    "typecheck": "npm -w @cifedra/core run typecheck && npm -w @cifedra/core run build && npm -w @cifedra/api run typecheck",
    "test": "npm -w @cifedra/core run test",
    "dev:api": "npm -w @cifedra/api run dev",
    "local:start": "node scripts/local/start.mjs",
    "local:stop": "node scripts/local/stop.mjs",
    "local:restart": "npm run local:stop && npm run local:start",
    "local:smoke": "node scripts/local/smoke-test.mjs",
    "docker:install": "node scripts/local/install-docker-desktop.mjs",
    "integrations:check": "node scripts/integrations/check.mjs",
    "integrations:install": "node scripts/integrations/install.mjs",
    "integrations:chatwoot:start": "node scripts/integrations/chatwoot-start.mjs",
    "integrations:chatwoot:bootstrap": "node scripts/integrations/chatwoot-bootstrap.mjs",
    "integrations:plane:install": "node scripts/integrations/plane-install.mjs",
    "integrations:plane:start": "node scripts/integrations/plane-start.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
